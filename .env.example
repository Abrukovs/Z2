# ====================================
# Ставка Дня — переменные окружения
# ====================================
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env

# База данных (SQLite, хранится в db/custom.db)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# OpenRouter API (для Nemotron cross-check)
# Получить ключ: https://openrouter.ai/ -> Sign up -> Keys
OPENROUTER_API_KEY=sk-or-v1-ВАШ_КЛЮЧ_ЗДЕСЬ

# Модель для cross-check (бесплатная)
CROSSCHECK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
